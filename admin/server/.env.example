PORT=8000
DATABASE_URL=
JWT_SECRET=replace-this
MESHSETU_ADMIN_EMAIL=operator@meshsetu.local
MESHSETU_ADMIN_PASSWORD=replace-this
MESHSETU_GATEWAY_SECRET=replace-this
MESHSETU_SITE_KEY_B64=
# Required outside local development. Keep this P-256 PKCS#8 PEM secret out of
# source control; base64 encode it when setting MESHSETU_AUTHORITY_PRIVATE_KEY_PEM_B64.
MESHSETU_AUTHORITY_PRIVATE_KEY_PEM_B64=
MESHSETU_AUTHORITY_KEY_ID=meshsetu-authority-dev-v1
MESHSETU_ADMIN_ORIGIN=
# Browser origin used by indefinitely-addressable notification links; defaults to the admin origin.
MESHSETU_PUBLIC_APP_ORIGIN=http://localhost:5173
CORS_ALLOWED_ORIGINS=
# Twilio SMS escalation. Set all four only in deployment secrets. `true` enables
# real carrier delivery for each resolved SOS emergency contact.
TWILIO_SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# India-capable fallback. Fast2SMS "Quick SMS" needs no DLT template and
# delivers to +91 numbers; get a free key from the Fast2SMS Dev API section.
FAST2SMS_API_KEY=
# Comma-separated delivery order; the first provider that accepts wins.
SMS_PROVIDER_ORDER=twilio,fast2sms
